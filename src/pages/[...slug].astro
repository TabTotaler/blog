---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{post.data.title} | TabTotaler Drink Blog</title>
        <meta name="description" content={post.data.description} />
    </head>
    <body class="bg-gray-50 text-gray-900 font-sans antialiased">
        <main class="max-w-3xl mx-auto px-4 py-12">
            <nav class="mb-8">
                <a href="/" class="text-blue-600 hover:underline font-medium">&larr; Back to all drinks</a>
            </nav>

            <article class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
                <header class="mb-8 border-b pb-6">
                    <h1 class="text-4xl font-extrabold mb-3 text-gray-900">{post.data.title}</h1>
                    <p class="text-sm text-gray-500">
                        <time datetime={post.data.pubDate}>
                            {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </time>
                    </p>
                </header>

                <div class="prose prose-lg max-w-none text-gray-700 space-y-4">
                    <Content />
                </div>
            </article>

            <footer class="mt-16 text-center text-sm text-gray-400">
                <p>&copy; {new Date().getFullYear()} TabTotaler. All rights reserved.</p>
            </footer>
        </main>
    </body>
</html>
