---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch all posts from the blog content collection and sort by pubDate
const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout title="TabTotaler Drink Blog — Real pours, standard drinks, and app updates.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">TabTotaler Blog</p>
      <h1>Drink Spotlights & Updates</h1>
      <p class="lede">Your daily automated guide to drink spotlights, stats, and recipes.</p>
    </div>
  </section>

  <section class="features">
    <div class="wrap">
      <div class="feature-grid">
        {posts.map((post) => (
          <article class="plan-card">
            <p class="plan-tier">
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
            </p>
            <h2>
              <a href={`/${post.id}/`} style="color: var(--paper);">
                {post.data.title}
              </a>
            </h2>
            <p style="color: var(--dim); margin-top: 10px; font-size: 0.95rem;">
              {post.data.description}
            </p>
            <div style="margin-top: 20px;">
              <a href={`/${post.id}/`} class="store-btn store-btn-secondary">
                Read Post →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
