---
import { getCollection } from 'astro:content';

// Fetch all posts from the blog content collection and sort by date
const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>TabTotaler Drink Blog</title>
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased">
		<main class="max-w-3xl mx-auto px-4 py-12">
			<header class="mb-12 text-center">
				<h1 class="text-4xl font-extrabold mb-3">TabTotaler Drink Blog</h1>
				<p class="text-gray-600 text-lg">Your daily automated guide to drink spotlights, stats, and recipes.</p>
			</header>

			<section>
				<ul class="space-y-6">
					{posts.map((post) => (
						<li>
							<a 
								href={`/blog/${post.id}`} 
								class="block p-6 bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition"
							>
								<h2 class="text-2xl font-bold text-gray-900 mb-2">{post.data.title}</h2>
								<p class="text-sm text-gray-500 mb-3">
									<time datetime={post.data.pubDate}>
										{new Date(post.data.pubDate).toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</time>
								</p>
								<p class="text-gray-700 leading-relaxed">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>

			<footer class="mt-16 text-center text-sm text-gray-400">
				<p>&copy; {new Date().getFullYear()} TabTotaler. All rights reserved.</p>
			</footer>
		</main>
	</body>
</html>
