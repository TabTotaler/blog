---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="TabTotaler Drink Blog" description="Automated beverage guides, cocktail recipes, and pairing metrics." />
	</head>
	<body>
		<Header />
		<main style="max-width: 800px; margin: 2rem auto; padding: 0 1rem; font-family: sans-serif;">
			<section>
				<h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; color: #111;">TabTotaler Drink Blog</h1>
				<p style="color: #666; margin-bottom: 2rem; font-size: 1.1rem;">Your daily automated guide to drink spotlights, stats, and recipes.</p>
				
				<ul style="padding: 0; list-style: none;">
					{
						posts.map((post) => (
							<li style="margin-bottom: 2.5rem; border-bottom: 1px solid #eaeaea; padding-bottom: 1.5rem;">
								<a href={`/${post.id}/`} style="text-decoration: none; font-size: 1.5rem; font-weight: bold; color: #0066cc;">
									{post.data.title}
								</a>
								<p style="color: #888; font-size: 0.85rem; margin: 0.4rem 0;">
									{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
								</p>
								<p style="color: #444; margin-top: 0.5rem; line-height: 1.5;">{post.data.description}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
