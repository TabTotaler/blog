---
import Layout from './Layout.astro';

// Support both Markdown frontmatter and standard Astro props
const { frontmatter, title, description, date, author } = Astro.props;

const postTitle = frontmatter?.title || title || "TabTotaler Blog";
const postDescription = frontmatter?.description || description;
const postDate = frontmatter?.date || date;
const postAuthor = frontmatter?.author || author || 'TabTotaler Team';
---

<Layout title={`${postTitle} — TabTotaler Blog`} description={postDescription}>
  <article class="wrap legal-page">
    {postDate && (
      <p class="eyebrow">
        {new Date(postDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </p>
    )}
    <h1>{postTitle}</h1>
    {postAuthor && <p class="legal-updated" style="margin-bottom: 36px;">By {postAuthor}</p>}
    
    <div class="blog-content" style="color: var(--dim); line-height: 1.75;">
      <slot />
    </div>

    <div class="legal-back">
      <a href="/" class="store-btn store-btn-secondary">← Back to all posts</a>
    </div>
  </article>
</Layout>

<style>
  .blog-content :global(h2) {
    font-size: 1.4rem;
    color: var(--brass);
    margin: 36px 0 12px;
  }
  .blog-content :global(h3) {
    font-size: 1.15rem;
    color: var(--paper);
    margin: 24px 0 8px;
  }
  .blog-content :global(p) {
    margin-bottom: 20px;
  }
  .blog-content :global(ul) {
    margin-bottom: 20px;
    padding-left: 20px;
  }
  .blog-content :global(li) {
    margin-bottom: 8px;
  }
  .blog-content :global(strong) {
    color: var(--paper);
  }
</style>
