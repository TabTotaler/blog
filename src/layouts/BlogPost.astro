---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} — TabTotaler Blog`} description={frontmatter.description}>
  <article class="wrap legal-page">
    <p class="eyebrow">{new Date(frontmatter.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
    <h1>{frontmatter.title}</h1>
    <p class="legal-updated" style="margin-bottom: 36px;">By {frontmatter.author || 'TabTotaler Team'}</p>
    
    <div class="blog-content" style="color: var(--dim); line-height: 1.75;">
      <slot />
    </div>

    <div class="legal-back">
      <a href="/" class="store-btn store-btn-secondary">← Back to all posts</a>
    </div>
  </article>
</Layout>

<style>
  /* Extra styling for Markdown headings and elements within the post */
  .blog-content :global(h2) {
    font-size: 1.4rem;
    color: var(--brass);
    margin: 36px 0 12px;
  }
  .blog-content :global(h3) {
    font-size: 1.15rem;
    color: var(--paper);
    margin: 24px 0 8px;
  }
  .blog-content :global(p) {
    margin-bottom: 20px;
  }
  .blog-content :global(ul) {
    margin-bottom: 20px;
    padding-left: 20px;
  }
  .blog-content :global(li) {
    margin-bottom: 8px;
  }
  .blog-content :global(strong) {
    color: var(--paper);
  }
</style>
		<Footer />
	</body>
</html>
