---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

// Fallback safety if frontmatter properties are missing
const title = frontmatter?.title || 'TabTotaler Drink Blog';
const description = frontmatter?.description || 'Real pours, standard drinks, and honest tracking.';
const pubDate = frontmatter?.pubDate;
---

<Layout title={title} description={description}>
  <article class="wrap legal-page" style="max-width: 768px; padding-top: 48px; padding-bottom: 80px;">
    
    <!-- Meta / Date -->
    {pubDate && (
      <p class="eyebrow">
        {new Date(pubDate).toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
    )}

    <!-- Post Title -->
    <h1 style="margin-bottom: 24px; font-size: clamp(2rem, 4vw, 2.75rem);">{title}</h1>

    <!-- Optional description/lede -->
    {description && (
      <p class="lede" style="margin-bottom: 36px; font-size: 1.15rem;">{description}</p>
    )}

    <hr style="border: none; border-top: 1px solid var(--line); margin-bottom: 40px;" />

    <!-- Main Markdown/MDX Content Area -->
    <div class="blog-content" style="color: var(--dim); line-height: 1.8; font-size: 1.05rem;">
      <slot />
    </div>

    <!-- Back to Home Button -->
    <div style="margin-top: 56px;">
      <a href="/" class="store-btn store-btn-secondary">← Back to Blog Home</a>
    </div>

  </article>
</Layout>

<style>
  /* Extra styling for Markdown generated tags inside the blog content */
  .blog-content :global(h2) {
    color: var(--paper);
    margin-top: 40px;
    margin-bottom: 16px;
    font-size: 1.5rem;
  }
  .blog-content :global(h3) {
    color: var(--paper);
    margin-top: 32px;
    margin-bottom: 12px;
    font-size: 1.25rem;
  }
  .blog-content :global(p) {
    margin-bottom: 20px;
  }
  .blog-content :global(strong) {
    color: var(--paper);
  }
  .blog-content :global(ul), .blog-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }
  .blog-content :global(li) {
    margin-bottom: 8px;
  }
</style>
